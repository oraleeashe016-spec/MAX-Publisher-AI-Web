# Copy to .env on the backend host. Never commit real secrets.
APP_API_KEY=replace-with-a-long-random-secret
CORS_ORIGINS=https://oraleeashe016-spec.github.io

# Hybrid AI. Ollama must be reachable FROM the backend host.
AI_MODE=hybrid
OLLAMA_BASE_URL=
OLLAMA_MODEL=
# Groq Cloud. Account and API key must be managed by an adult account owner.
# Check current model availability and free-tier limits in Groq Console.
CLOUD_AI_PROVIDER=groq
CLOUD_AI_BASE_URL=https://api.groq.com/openai/v1
CLOUD_AI_API_KEY=
CLOUD_AI_MODEL=openai/gpt-oss-20b

# MAX bot token and channel ID. Bot must have channel posting permission.
MAX_BOT_TOKEN=
MAX_CHANNEL_ID=

# Optional HTTPS JSON feeds. Each URL must return either an array or {"items":[...]}.
# Each item: {"id":"sku","name":"Product name","price":12345,"old_price":15999,"url":"https://...","image":"https://...","category":"Смартфоны","checked_at":"ISO-8601"}
YANDEX_FEED_URL=
OZON_FEED_URL=
DNS_FEED_URL=
MVIDEO_FEED_URL=
CITILINK_FEED_URL=
